# AidRelay — example key configuration for the live smoke tests in tests/.
#
# The app itself does NOT read this file: in the app, you paste your own keys
# into its settings, and they stay in that browser's local storage only.
# These environment variables are only for re-running the recorded live
# smoke runs from a terminal:
#
#   export MODEL_API_KEY=...    # then: python3 tests/meta_smoke.py
#   export BASETEN_API_KEY=...  # then: python3 tests/baseten_smoke.py
#
# Or copy this file to ".env", fill it in, and load it in your shell.
# NEVER commit real keys — ".env" is covered by .gitignore.

# Meta Model API key (hosted Muse Spark 1.3 structuring; Spark 1.2 transcription).
MODEL_API_KEY=

# Baseten API key for meta-models/muse-spark-open-1026 (Muse Spark Open,
# Meta's open-weights model) — live structuring only.
BASETEN_API_KEY=
